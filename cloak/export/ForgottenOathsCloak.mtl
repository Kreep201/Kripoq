# Blender 4.5.16 LTS MTL File: 'cloak_scene.blend'
# www.blender.org

newmtl Cloak_Fabric
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ni 1.500000
illum 2
map_Kd ../textures/roblox_1024/Cloak_Fabric_Color.png
map_Ns ../textures/roblox_1024/Cloak_Fabric_Roughness.png
map_Ke ../textures/roblox_1024/Cloak_Fabric_Emissive.png
map_d ../textures/roblox_1024/Cloak_Fabric_Color.png
map_Bump -bm 1.000000 ../textures/roblox_1024/Cloak_Fabric_Normal.png

newmtl Cloak_Hardware
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 2
map_Kd ../textures/roblox_1024/Cloak_Hardware_Color.png
map_Ns ../textures/roblox_1024/Cloak_Hardware_Roughness.png
map_refl ../textures/roblox_1024/Cloak_Hardware_Metalness.png
map_Bump -bm 1.000000 ../textures/roblox_1024/Cloak_Hardware_Normal.png
